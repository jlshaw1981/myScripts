def load_json_file(file_path: str) -> Dict:
    """
    Load and parse the JSON file.
    
    Args:
        file_path: Path to the JSON file
        
    Returns:
        Parsed JSON data as a dictionary
    """
    try:
        with open(file_path, 'r') as file:
            data = json.load(file)
        print(f"Successfully loaded data from {file_path}")
        return data
    except FileNotFoundError:
        print(f"Error: File {file_path} not found.")
        sys.exit(1)
    except json.JSONDecodeError:
        print(f"Error: {file_path} is not a valid JSON file.")
        sys.exit(1)
    except Exception as e:
        print(f"Error loading JSON file: {e}")
        sys.exit(1)


def find_yn_dictionaries(data: Any, path: str = "", results: List[Tuple[str, Dict]] = None) -> List[Tuple[str, Dict]]:
    """
    Recursively find all dictionaries with keys starting with "YN-".
    
    Args:
        data: The JSON data to search through
        path: Current path in the JSON structure (for tracking location)
        results: List to store found dictionaries
        
    Returns:
        List of tuples containing (path, dictionary)
    """
    if results is None:
        results = []
    
    # If data is a dictionary
    if isinstance(data, dict):
        # Check all keys in this dictionary
        for key, value in data.items():
            current_path = f"{path}.{key}" if path else key
            
            # Check if this key starts with "YN-"
            if key.startswith("YN-"):
                results.append((current_path, data[key]))
            
            # Recursively check nested dictionaries
            if isinstance(value, (dict, list)):
                find_yn_dictionaries(value, current_path, results)
                
    # If data is a list
    elif isinstance(data, list):
        # Check each item in the list
        for i, item in enumerate(data):
            current_path = f"{path}[{i}]"
            if isinstance(item, (dict, list)):
                find_yn_dictionaries(item, current_path, results)
    
    return results


def display_yn_dictionaries(yn_dicts: List[Tuple[str, Dict]]) -> Tuple[str, Dict]:
    """
    Display the found dictionaries and let user choose one using questionary.
    
    Args:
        yn_dicts: List of tuples containing (path, dictionary)
        
    Returns:
        Tuple containing (path, selected dictionary)
    """
    if not yn_dicts:
        print("No dictionaries with keys starting with 'YN-' found in the JSON file.")
        sys.exit(0)
    
    print(f"Found {len(yn_dicts)} dictionaries with keys starting with 'YN-':")
    
    # Create choices for questionary
    choices = []
    for i, (path, dict_data) in enumerate(yn_dicts):
        # Create a summary of the dictionary
        summary = str(dict_data)
        if len(summary) > 50:
            summary = summary[:47] + "..."
            
        # Create a choice with the path and summary
        choice_text = f"{path}: {summary}"
        choices.append((choice_text, i))
    
    # Let user select a dictionary
    selected = questionary.select(
        "Select a dictionary:",
        choices=[choice[0] for choice in choices]
    ).ask()
    
    if selected is None:
        print("No selection made. Exiting.")
        sys.exit(0)
    
    # Find the index of the selected dictionary
    selected_index = next(choice[1] for choice in choices if choice[0] == selected)
    
    return yn_dicts[selected_index]


def display_selected_dictionary(selected_dict: Dict) -> None:
    """
    Display the selected dictionary in a formatted way.
    
    Args:
        selected_dict: The dictionary to display
    """
    print("\nSelected Dictionary:")
    print("-" * 50)
    
    # Format the dictionary as pretty JSON
    formatted_json = json.dumps(selected_dict, indent=4)
    print(formatted_json)
    print("-" * 50)


def extract_ip_addresses(data: Any, ip_info: List[Dict] = None) -> List[Dict]:
    """
    Recursively extract all IP addresses from the dictionary.
    
    Args:
        data: The dictionary to extract IPs from
        ip_info: List to store found IP addresses and hostnames
        
    Returns:
        List of dictionaries with 'hostname' and 'ip_address' keys
    """
    if ip_info is None:
        ip_info = []
    
    # If data is a dictionary
    if isinstance(data, dict):
        # Check if this dictionary contains both hostname and ip_address
        if "Hostname" in data and "ip_address" in data:
            ip_info.append({
                "hostname": data["Hostname"],
                "ip_address": data["ip_address"],
            })
        
        # Check all values in this dictionary
        for value in data.values():
            if isinstance(value, (dict, list)):
                extract_ip_addresses(value, ip_info)
    
    # If data is a list
    elif isinstance(data, list):
        # Check each item in the list
        for item in data:
            if isinstance(item, (dict, list)):
                extract_ip_addresses(item, ip_info)
    
    return ip_info


def ssh_connect(host: str, username: str, password: str = None, key_path: str = None, port: int = 22) -> paramiko.SSHClient:
    """
    Connect to a remote host via SSH.
    
    Args:
        host: Remote host IP address or hostname
        username: SSH username
        password: SSH password (optional)
        key_path: Path to private key file (optional)
        port: SSH port (default: 22)
        
    Returns:
        SSHClient object if connection successful, None otherwise
    """
    client = paramiko.SSHClient()
    client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    
    try:
        if key_path:
            key = paramiko.RSAKey.from_private_key_file(key_path)
            client.connect(hostname=host, port=port, username=username, pkey=key, timeout=10)
        else:
            client.connect(hostname=host, port=port, username=username, password=password, timeout=10)
        
        print(f"Successfully connected to {host}")
        return client
    except Exception as e:
        print(f"SSH connection failed: {e}")
        return None


def execute_ssh_command(client: paramiko.SSHClient, command: str) -> Tuple[str, str, int]:
    """
    Execute a command on a remote host via SSH.
    
    Args:
        client: SSHClient object
        command: Command to execute
        
    Returns:
        Tuple containing (stdout, stderr, return_code)
    """
    try:
        # Execute the command
        stdin, stdout, stderr = client.exec_command(command, timeout=30)
        
        # Get the return code
        return_code = stdout.channel.recv_exit_status()
        
        # Get output
        stdout_str = stdout.read().decode('utf-8')
        stderr_str = stderr.read().decode('utf-8')
        
        return stdout_str, stderr_str, return_code
    except Exception as e:
        return "", str(e), -1


def execute_audit(ip: str, hostname: str) -> None:
    """
    Execute a set of audit commands on a remote host via SSH.
    
    Args:
        ip: IP address of the remote host
        hostname: Hostname of the remote host
    """
    print(f"\n{'=' * 60}")
    print(f"Executing Audit on {hostname} ({ip}):")
    print(f"{'=' * 60}")
    
    # Get SSH credentials
    ssh_username = questionary.text(f"Enter SSH username for {hostname} ({ip}):").ask()
    
    # Ask for authentication method
    auth_method = questionary.select(
        f"Select authentication method for {hostname} ({ip}):",
        choices=["Password", "Private Key"]
    ).ask()
    
    ssh_password = None
    key_path = None
    
    if auth_method == "Password":
        ssh_password = questionary.password(f"Enter SSH password for {hostname} ({ip}):").ask()
    else:  # Private Key
        key_path = questionary.text("Enter path to private key file:").ask()
    
    # Connect to SSH
    ssh_client = ssh_connect(ip, ssh_username, ssh_password, key_path)
    
    if ssh_client:
        # List of audit commands to run
        audit_commands = [
            "hostname",
            "ping -c 4 1.1.1.1",
            "ifconfig || ip a",
            "route -n || ip route",
            "cat /etc/os-release",
            "uname -a",
            "uptime"
        ]
        
        # Execute each audit command
        print("\nExecuting audit commands...")
        for cmd in audit_commands:
            print(f"\n--- Command: {cmd} ---")
            stdout, stderr, return_code = execute_ssh_command(ssh_client, cmd)
            
            if return_code == 0:
                print(stdout)
            else:
                print(f"Command failed with error code {return_code}:")
                if stderr:
                    print(stderr)
        
        # Close SSH connection
        ssh_client.close()
        print(f"\nSSH connection to {hostname} closed")
        print(f"{'=' * 60}")
    else:
        print(f"Audit failed: Could not establish SSH connection to {hostname} ({ip})")


def run_network_commands(ip_info: List[Dict]) -> None:
    """
    Run network commands on each IP address.
    
    Args:
        ip_info: List of dictionaries with 'hostname' and 'ip_address' keys
    """
    if not ip_info:
        print("No IP addresses found in the selected dictionary.")
        return
    
    # Display found hosts and IPs
    print("\nFound the following hosts and IP addresses:")
    print("-" * 60)
    print(f"{'Hostname':<30} {'IP Address':<15}")
    print("-" * 60)
    for item in ip_info:
        print(f"{item['hostname']:<30} {item['ip_address']:<15}")
    print("-" * 60)
    
    # Let user select which IPs to run commands on
    choices = [f"{item['hostname']} ({item['ip_address']})" for item in ip_info]
    selected = questionary.checkbox(
        "Select hosts to audit:",
        choices=choices
    ).ask()
    
    if not selected:
        print("No hosts selected. Skipping audit.")
        return
    
    # Extract selected IP addresses and hostnames
    selected_hosts = []
    for sel in selected:
        # Extract hostname and IP from the selection string (format: "hostname (ip)")
        hostname = sel.split(" (")[0]
        ip = sel.split("(")[1].rstrip(")")
        selected_hosts.append({"hostname": hostname, "ip_address": ip})
    
    # Create and start threads as well as execute audit on each selected host.
    #for host in selected_hosts:
    #    execute_audit(host["ip_address"], host["hostname"])
    threads = []
    for host in selected_hosts:
        t = threading.Thread(target=execute_audit, args=(host["ip_address"], host["hostname"]))
        t.start()
        threads.append(t)
    
    # Wait for all threads to finish
    for t in threads:
        t.join()

    print("All audits completed.")

def main():
    """Main function to run the script."""
    require_root()
    print("=" * 70)
    print("JSON YN- Dictionary Finder with SSH Audit")
    print("=" * 70)
    
    # Get JSON file path
    json_path = "path_info.json"
    
    try:
        # Load the JSON data
        data = load_json_file(json_path)

        # Find all dictionaries with keys starting with "YN-"
        yn_dicts = find_yn_dictionaries(data)

        # Let user select a dictionary
        path, selected_dict = display_yn_dictionaries(yn_dicts)

        # Display the selected dictionary
        display_selected_dictionary(selected_dict)

        # Extract IP addresses from the selected dictionary
        ip_info = extract_ip_addresses(selected_dict)

        # Run audit on extracted IP addresses
        run_network_commands(ip_info)

        # Ask if user wants to save the selected dictionary to a file
        save_to_file = questionary.confirm("Do you want to save the selected dictionary to a file?").ask()

        if save_to_file:
            output_path = questionary.text(
                "Enter output file path:",
                default="selected_yn_dict.json"
            ).ask()

            try:
                with open(output_path, 'w') as file:
                    json.dump(selected_dict, file, indent=4)
                print(f"Successfully saved to {output_path}")
            except Exception as e:
                print(f"Error saving to file: {e}")
    
    except KeyboardInterrupt:
        print("\n\nExecution interrupted by user. Exiting.")
        sys.exit(0)

if __name__ == "__main__":
    try:
        while True:
            main()
            again = questionary.confirm("Run the script again?").ask()
            if not again:
                print("Exiting.")
                break
    except KeyboardInterrupt:
        print("\n\nExecution interrupted by user. Exiting.")
        sys.exit(0)




