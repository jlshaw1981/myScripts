#!/usr/bin/env python3

import json
import sys
import questionary
import paramiko
import os
import time
import queue
from concurrent.futures import ThreadPoolExecutor
from typing import Dict, List, Any, Tuple


def load_json_file(file_path: str) -> Dict:
    """
    Load and parse the JSON file.
    
    Args:
        file_path: Path to the JSON file
        
    Returns:
        Parsed JSON data as a dictionary
    """
    try:
        with open(file_path, 'r') as file:
            data = json.load(file)
        print(f"Successfully loaded data from {file_path}")
        return data
    except FileNotFoundError:
        print(f"Error: File {file_path} not found.")
        sys.exit(1)
    except json.JSONDecodeError:
        print(f"Error: {file_path} is not a valid JSON file.")
        sys.exit(1)
    except Exception as e:
        print(f"Error loading JSON file: {e}")
        sys.exit(1)


def find_yn_dictionaries(data: Any, path: str = "", results: List[Tuple[str, Dict]] = None) -> List[Tuple[str, Dict]]:
    """
    Recursively find all dictionaries with keys starting with "YN-".
    
    Args:
        data: The JSON data to search through
        path: Current path in the JSON structure (for tracking location)
        results: List to store found dictionaries
        
    Returns:
        List of tuples containing (path, dictionary)
    """
    if results is None:
        results = []
    
    # If data is a dictionary
    if isinstance(data, dict):
        # Check all keys in this dictionary
        for key, value in data.items():
            current_path = f"{path}.{key}" if path else key
            
            # Check if this key starts with "YN-"
            if key.startswith("YN-"):
                results.append((current_path, data[key]))
            
            # Recursively check nested dictionaries
            if isinstance(value, (dict, list)):
                find_yn_dictionaries(value, current_path, results)
                
    # If data is a list
    elif isinstance(data, list):
        # Check each item in the list
        for i, item in enumerate(data):
            current_path = f"{path}[{i}]"
            if isinstance(item, (dict, list)):
                find_yn_dictionaries(item, current_path, results)
    
    return results


def display_yn_dictionaries(yn_dicts: List[Tuple[str, Dict]]) -> Tuple[str, Dict]:
    """
    Display the found dictionaries and let user choose one using questionary.
    
    Args:
        yn_dicts: List of tuples containing (path, dictionary)
        
    Returns:
        Tuple containing (path, selected dictionary)
    """
    if not yn_dicts:
        print("No dictionaries with keys starting with 'YN-' found in the JSON file.")
        sys.exit(0)
    
    print(f"Found {len(yn_dicts)} dictionaries with keys starting with 'YN-':")
    
    # Create choices for questionary
    choices = []
    # Fix the unpacking issue by safely accessing tuple elements
    for i, item in enumerate(yn_dicts):
        if isinstance(item, tuple) and len(item) >= 2:
            path = item[0]
            dict_data = item[1]
            
            # Create a summary of the dictionary
            summary = str(dict_data)
            if len(summary) > 50:
                summary = summary[:47] + "..."
                
            # Create a choice with the path and summary
            choice_text = f"{path}: {summary}"
            choices.append((choice_text, i))
    
    # Let user select a dictionary
    selected = questionary.select(
        "Select a dictionary:",
        choices=[choice[0] for choice in choices]
    ).ask()
    
    if selected is None:
        print("No selection made. Exiting.")
        sys.exit(0)
    
    # Find the index of the selected dictionary
    selected_index = next(choice[1] for choice in choices if choice[0] == selected)
    
    return yn_dicts[selected_index]


def display_selected_dictionary(selected_dict: Dict) -> None:
    """
    Display the selected dictionary in a formatted way.
    
    Args:
        selected_dict: The dictionary to display
    """
    print("\nSelected Dictionary:")
    print("-" * 50)
    
    # Format the dictionary as pretty JSON
    formatted_json = json.dumps(selected_dict, indent=4)
    print(formatted_json)
    print("-" * 50)


def extract_ip_addresses(data: Any, ip_info: List[Dict] = None) -> List[Dict]:
    """
    Recursively extract all IP addresses from the dictionary.
    
    Args:
        data: The dictionary to extract IPs from
        ip_info: List to store found IP addresses and hostnames
        
    Returns:
        List of dictionaries with 'hostname' and 'ip_address' keys
    """
    if ip_info is None:
        ip_info = []
    
    # If data is a dictionary
    if isinstance(data, dict):
        # Check if this dictionary contains both hostname and ip_address
        if "Hostname" in data and "ip_address" in data:
            ip_info.append({
                "hostname": data["Hostname"],
                "ip_address": data["ip_address"],
            })
        
        # Check all values in this dictionary
        for value in data.values():
            if isinstance(value, (dict, list)):
                extract_ip_addresses(value, ip_info)
    
    # If data is a list
    elif isinstance(data, list):
        # Check each item in the list
        for item in data:
            if isinstance(item, (dict, list)):
                extract_ip_addresses(item, ip_info)
    
    return ip_info


def ssh_connect(host: str, username: str, password: str = None, key_path: str = None, port: int = 22) -> paramiko.SSHClient:
    """
    Connect to a remote host via SSH.
    
    Args:
        host: Remote host IP address or hostname
        username: SSH username
        password: SSH password (optional)
        key_path: Path to private key file (optional)
        port: SSH port (default: 22)
        
    Returns:
        SSHClient object if connection successful, None otherwise
    """
    client = paramiko.SSHClient()
    client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    
    try:
        if key_path:
            key = paramiko.RSAKey.from_private_key_file(key_path)
            client.connect(hostname=host, port=port, username=username, pkey=key, timeout=10)
        else:
            client.connect(hostname=host, port=port, username=username, password=password, timeout=10)
        
        print(f"Successfully connected to {host}")
        return client
    except Exception as e:
        print(f"SSH connection failed to {host}: {e}")
        return None


def execute_ssh_command(client: paramiko.SSHClient, command: str) -> Tuple[str, str, int]:
    """
    Execute a command on a remote host via SSH.
    
    Args:
        client: SSHClient object
        command: Command to execute
        
    Returns:
        Tuple containing (stdout, stderr, return_code)
    """
    try:
        # Execute the command
        stdin, stdout, stderr = client.exec_command(command, timeout=30)
        
        # Get the return code
        return_code = stdout.channel.recv_exit_status()
        
        # Get output
        stdout_str = stdout.read().decode('utf-8')
        stderr_str = stderr.read().decode('utf-8')
        
        return stdout_str, stderr_str, return_code
    except Exception as e:
        return "", str(e), -1


def execute_audit_worker(host_info: Dict, ssh_username: str, ssh_password: str = None, key_path: str = None,
                         result_queue: queue.Queue = None) -> Dict:
    """
    Worker function to execute audit on a single host.
    
    Args:
        host_info: Dictionary with host information
        ssh_username: SSH username
        ssh_password: SSH password (optional)
        key_path: Path to private key file (optional)
        result_queue: Queue to put results in (optional)
        
    Returns:
        Dictionary with audit results
    """
    ip = host_info["ip_address"]
    hostname = host_info["hostname"]
    
    host_results = {
        "hostname": hostname,
        "ip_address": ip,
        "commands": []
    }
    
    print(f"\n{'=' * 60}")
    print(f"Executing Audit on {hostname} ({ip}):")
    print(f"{'=' * 60}")
    
    # Connect to SSH
    ssh_client = ssh_connect(ip, ssh_username, ssh_password, key_path)
    
    if ssh_client:
        # List of audit commands to run
        audit_commands = [
            "hostname",
            "ping -c 4 1.1.1.1",
            "ifconfig || ip a",
            "route -n || ip route",
            "cat /etc/os-release",
            "uname -a",
            "uptime"
        ]
        
        # Execute each audit command
        print(f"\nExecuting audit commands on {hostname}...")
        for cmd in audit_commands:
            print(f"\n--- {hostname}: Command: {cmd} ---")
            stdout, stderr, return_code = execute_ssh_command(ssh_client, cmd)
            
            command_result = {
                "command": cmd,
                "return_code": return_code,
                "stdout": stdout,
                "stderr": stderr
            }
            
            host_results["commands"].append(command_result)
            
            if return_code == 0:
                print(f"{hostname}: {cmd} executed successfully")
            else:
                print(f"{hostname}: {cmd} failed with error code {return_code}")
        
        # Close SSH connection
        ssh_client.close()
        print(f"\nSSH connection to {hostname} closed")
        print(f"{'=' * 60}")
    else:
        print(f"Audit failed: Could not establish SSH connection to {hostname} ({ip})")
        host_results["error"] = "SSH connection failed"
    
    # Put results in queue if provided
    if result_queue is not None:
        result_queue.put(host_results)
    
    return host_results


def run_multithreaded_audit(selected_hosts: List[Dict], max_workers: int = 10) -> List[Dict]:
    """
    Run audit commands on multiple hosts using threads.
    
    Args:
        selected_hosts: List of dictionaries with host information
        max_workers: Maximum number of worker threads
        
    Returns:
        List of dictionaries with audit results
    """
    audit_results = []
    result_queue = queue.Queue()
    
    # Get common SSH credentials
    print("\nEnter common SSH credentials for all hosts:")
    ssh_username = questionary.text("Enter SSH username:").ask()
    
    # Ask for authentication method
    auth_method = questionary.select(
        "Select authentication method:",
        choices=["Password", "Private Key"]
    ).ask()
    
    ssh_password = None
    key_path = None
    
    if auth_method == "Password":
        ssh_password = questionary.password("Enter SSH password:").ask()
    else:  # Private Key
        key_path = questionary.text("Enter path to private key file:").ask()
    
    # Ask for maximum concurrent connections
    actual_max_workers = min(max_workers, len(selected_hosts))
    num_workers = questionary.select(
        "Select maximum concurrent connections:",
        choices=[str(n) for n in range(1, actual_max_workers + 1)]
    ).ask()
    
    num_workers = int(num_workers)
    print(f"\nUsing {num_workers} concurrent connections")
    
    # Create a thread pool
    with ThreadPoolExecutor(max_workers=num_workers) as executor:
        # Submit tasks
        futures = []
        for host in selected_hosts:
            future = executor.submit(
                execute_audit_worker,
                host_info=host,
                ssh_username=ssh_username,
                ssh_password=ssh_password,
                key_path=key_path,
                result_queue=result_queue
            )
            futures.append(future)
        
        # Track progress
        completed = 0
        total = len(futures)
        
        while completed < total:
            completed = sum(1 for f in futures if f.done())
            print(f"\rProgress: {completed}/{total} hosts completed", end="")
            time.sleep(0.5)
        
        print("\nAll hosts completed!")
    
    # Get results from queue
    while not result_queue.empty():
        audit_results.append(result_queue.get())
    
    return audit_results


def run_network_commands(ip_info: List[Dict]) -> List[Dict]:
    """
    Run network commands on each IP address.
    
    Args:
        ip_info: List of dictionaries with 'hostname' and 'ip_address' keys
        
    Returns:
        List of dictionaries with audit results
    """
    if not ip_info:
        print("No IP addresses found in the selected dictionary.")
        return []
    
    # Display found hosts and IPs
    print("\nFound the following hosts and IP addresses:")
    print("-" * 60)
    print(f"{'Hostname':<30} {'IP Address':<15}")
    print("-" * 60)
    for item in ip_info:
        print(f"{item['hostname']:<30} {item['ip_address']:<15}")
    print("-" * 60)
    
    # Let user select which IPs to run commands on
    choices = [f"{item['hostname']} ({item['ip_address']})" for item in ip_info]
    selected = questionary.checkbox(
        "Select hosts to audit:",
        choices=choices
    ).ask()
    
    if not selected:
        print("No hosts selected. Skipping audit.")
        return []
    
    # Extract selected IP addresses and hostnames
    selected_hosts = []
    for sel in selected:
        # Extract hostname and IP from the selection string (format: "hostname (ip)")
        hostname = sel.split(" (")[0]
        ip = sel.split("(")[1].rstrip(")")
        selected_hosts.append({"hostname": hostname, "ip_address": ip})
    
    # Ask if user wants to use multithreading
    use_threading = questionary.confirm(
        "Do you want to run audit commands in parallel on all hosts?",
        default=True
    ).ask()
    
    if use_threading:
        # Run commands in parallel
        audit_results = run_multithreaded_audit(selected_hosts)
    else:
        # Run commands sequentially
        audit_results = []
        for host in selected_hosts:
            # Get SSH credentials for each host
            print(f"\nEnter SSH credentials for {host['hostname']} ({host['ip_address']}):")
            ssh_username = questionary.text(f"Enter SSH username for {host['hostname']}:").ask()
            
            # Ask for authentication method
            auth_method = questionary.select(
                f"Select authentication method for {host['hostname']}:",
                choices=["Password", "Private Key"]
            ).ask()
            
            ssh_password = None
            key_path = None
            
            if auth_method == "Password":
                ssh_password = questionary.password(f"Enter SSH password for {host['hostname']}:").ask()
            else:  # Private Key
                key_path = questionary.text("Enter path to private key file:").ask()
            
            # Execute audit
            host_result = execute_audit_worker(
                host_info=host,
                ssh_username=ssh_username,
                ssh_password=ssh_password,
                key_path=key_path
            )
            
            audit_results.append(host_result)
    
    return audit_results


def save_audit_results(audit_results: List[Dict]) -> None:
    """
    Save audit results to a file.
    
    Args:
        audit_results: List of dictionaries with audit results
    """
    if not audit_results:
        print("No audit results to save.")
        return
    
    # Ask if user wants to save the audit results
    save_to_file = questionary.confirm("Do you want to save the audit results to a file?").ask()
    
    if save_to_file:
        # Ask for output directory
        output_dir = questionary.text(
            "Enter output directory (leave empty for current directory):",
            default=""
        ).ask()
        
        if output_dir and not os.path.exists(output_dir):
            try:
                os.makedirs(output_dir)
                print(f"Created directory: {output_dir}")
            except Exception as e:
                print(f"Error creating directory: {e}")
                output_dir = ""
        
        # Save results for each host
        for host_result in audit_results:
            hostname = host_result["hostname"]
            ip = host_result["ip_address"]
            
            # Create filename
            filename = f"audit_{hostname}_{ip.replace('.', '_')}.txt"
            if output_dir:
                filepath = os.path.join(output_dir, filename)
            else:
                filepath = filename
            
            try:
                with open(filepath, 'w') as file:
                    file.write(f"Audit Results for {hostname} ({ip})\n")
                    file.write("=" * 60 + "\n\n")
                    
                    if "error" in host_result:
                        file.write(f"ERROR: {host_result['error']}\n\n")
                    
                    for cmd_result in host_result.get("commands", []):
                        command = cmd_result.get("command", "Unknown command")
                        return_code = cmd_result.get("return_code", -1)
                        stdout = cmd_result.get("stdout", "")
                        stderr = cmd_result.get("stderr", "")
                        
                        file.write(f"Command: {command}\n")
                        file.write("-" * 40 + "\n")
                        
                        if return_code == 0:
                            file.write(f"Output:\n{stdout}\n")
                        else:
                            file.write(f"Command failed with error code {return_code}:\n")
                            if stderr:
                                file.write(f"{stderr}\n")
                        
                        file.write("\n" + "-" * 40 + "\n\n")
                
                print(f"Successfully saved audit results to {filepath}")
            except Exception as e:
                print(f"Error saving audit results: {e}")


def main():
    """Main function to run the script."""
    print("=" * 70)
    print("JSON YN- Dictionary Finder with Multithreaded SSH Audit")
    print("=" * 70)
    
    # Get JSON file path
    json_path = "path_info.json"
    
    # Load the JSON data
    data = load_json_file(json_path)
    
    # Find all dictionaries with keys starting with "YN-"
    yn_dicts = find_yn_dictionaries(data)
    
    # Let user select a dictionary
    path, selected_dict = display_yn_dictionaries(yn_dicts)
    
    # Display the selected dictionary
    display_selected_dictionary(selected_dict)
    
    # Extract IP addresses from the selected dictionary
    ip_info = extract_ip_addresses(selected_dict)
    
    # Run audit on extracted IP addresses and get results
    audit_results = run_network_commands(ip_info)
    
    # Save audit results to file
    save_audit_results(audit_results)
    
    print("=" * 70)
    print("Script execution completed!")
    print("=" * 70)


def run_script():
    """Function to run the script and then ask if user wants to run again."""
    while True:
        try:
            # Run the main functionality
            main()
            
            # Ask if the user wants to run the script again using questionary
            run_again = questionary.confirm(
                "Would you like to run the script again?",
                default=False
            ).ask()
            
            if not run_again:
                print("\nExiting program. Goodbye!")
                break
            
            # Add a separator before running again
            print("\n" + "=" * 70)
            print("Restarting script...")
            print("=" * 70 + "\n")
            
        except KeyboardInterrupt:
            print("\nProgram terminated by user.")
            break
        except Exception as e:
            print(f"An error occurred: {e}")
            # Still ask if they want to run again even after an error
            run_again = questionary.confirm(
                "An error occurred. Would you like to try running the script again?",
                default=False
            ).ask()
            
            if not run_again:
                print("\nExiting program. Goodbye!")
                break


if __name__ == "__main__":
    run_script()
