# Global flag to track if Ctrl+C was pressed
interrupted = False

def signal_handler(sig, frame):
    """Handle Ctrl+C (SIGINT) gracefully."""
    global interrupted
    interrupted = True
    print("\n\nCtrl+C detected. Cleaning up and exiting...")
    # Don't exit immediately, let the current operation clean up gracefully
    # The interrupted flag will be checked throughout the code

def setup_signal_handler():
    """Setup the signal handler for Ctrl+C."""
    signal.signal(signal.SIGINT, signal_handler)

def check_interrupted():
    """Check if the script has been interrupted and exit if needed."""
    global interrupted
    if interrupted:
        print("\nOperation cancelled by user. Exiting.")
        sys.exit(0)

def require_root():
    """Ensure the script is run with root privileges."""
    if os.name != 'nt':  # Only check EUID on Unix-like systems
        if os.geteuid() != 0:
            print("Error: This script must be run as root. Try again with 'sudo'.")
            sys.exit(1)
    else:
        print("Warning: Root check is not supported on Windows. Proceeding anyway.")


def scp_opsdata(host: str, remote_path: str, local_path: str = '.', username: str = None, 
               password: str = None, key_path: str = None, port: int = 22) -> bool:
    """
    Copy a file from a remote host to the local directory using SCP.
    
    Args:
        host: Remote host IP address or hostname
        remote_path: Path to the file on the remote host
        local_path: Local directory to copy the file to (default: current directory)
        username: SSH username
        password: SSH password (optional)
        key_path: Path to private key file (optional)
        port: SSH port (default: 22)
        
    Returns:
        bool: True if successful, False otherwise
    """
    try:
        check_interrupted()  # Check if Ctrl+C was pressed
        
        # Connect to SSH
        ssh_client = ssh_connect(host, username, password, key_path, port)
        
        if not ssh_client:
            print(f"SCP failed: Could not establish SSH connection to {host}")
            return False
        
        # Create SCP client
        with SCPClient(ssh_client.get_transport()) as scp:
            # Get filename from remote path
            filename = os.path.basename(remote_path)
            local_file_path = os.path.join(local_path, filename)
            
            # Copy the file
            print(f"Copying {remote_path} from {host} to {local_file_path}...")
            scp.get(remote_path, local_file_path)
            
            check_interrupted()  # Check if Ctrl+C was pressed
            
            # Verify the file was copied
            if os.path.exists(local_file_path):
                file_size = os.path.getsize(local_file_path)
                print(f"Successfully copied {filename} ({file_size} bytes)")
                return True
            else:
                print(f"File transfer completed but {local_file_path} not found")
                return False
    
    except Exception as e:
        if interrupted:  # Check if the exception was due to interruption
            return False
        print(f"SCP transfer failed: {e}")
        return False
    finally:
        # Close SSH connection if it exists
        if 'ssh_client' in locals() and ssh_client:
            ssh_client.close()


def load_json_file(file_path: str) -> Dict:
    """
    Load and parse the JSON file.
    
    Args:
        file_path: Path to the JSON file
        
    Returns:
        Parsed JSON data as a dictionary
    """
    try:
        check_interrupted()  # Check if Ctrl+C was pressed
        
        with open(file_path, 'r') as file:
            data = json.load(file)
        print(f"Successfully loaded data from {file_path}")
        return data
    except FileNotFoundError:
        print(f"Error: File {file_path} not found.")
        sys.exit(1)
    except json.JSONDecodeError:
        print(f"Error: {file_path} is not a valid JSON file.")
        sys.exit(1)
    except Exception as e:
        if interrupted:  # Check if the exception was due to interruption
            sys.exit(0)
        print(f"Error loading JSON file: {e}")
        sys.exit(1)


def find_yn_dictionaries(data: Any, path: str = "", results: List[Tuple[str, Dict]] = None) -> List[Tuple[str, Dict]]:
    """
    Recursively find all dictionaries with keys starting with "YN-".
    
    Args:
        data: The JSON data to search through
        path: Current path in the JSON structure (for tracking location)
        results: List to store found dictionaries
        
    Returns:
        List of tuples containing (path, dictionary)
    """
    check_interrupted()  # Check if Ctrl+C was pressed
    
    if results is None:
        results = []
    
    # If data is a dictionary
    if isinstance(data, dict):
        # Check all keys in this dictionary
        for key, value in data.items():
            current_path = f"{path}.{key}" if path else key
            
            # Check if this key starts with "YN-"
            if key.startswith("YN-"):
                results.append((current_path, data[key]))
            
            # Recursively check nested dictionaries
            if isinstance(value, (dict, list)):
                find_yn_dictionaries(value, current_path, results)
                
    # If data is a list
    elif isinstance(data, list):
        # Check each item in the list
        for i, item in enumerate(data):
            current_path = f"{path}[{i}]"
            if isinstance(item, (dict, list)):
                find_yn_dictionaries(item, current_path, results)
    
    return results


def display_yn_dictionaries(yn_dicts: List[Tuple[str, Dict]]) -> Tuple[str, Dict]:
    """
    Display the found dictionaries and let user choose one using PyInquirer.
    
    Args:
        yn_dicts: List of tuples containing (path, dictionary)
        
    Returns:
        Tuple containing (path, selected dictionary)
    """
    check_interrupted()  # Check if Ctrl+C was pressed
    
    if not yn_dicts:
        print("No dictionaries with keys starting with 'YN-' found in the JSON file.")
        sys.exit(0)
    
    print(f"Found {len(yn_dicts)} dictionaries with keys starting with 'YN-':")
    
    # Create choices for PyInquirer
    choices = []
    # Fix the unpacking issue by safely accessing tuple elements
    for i, item in enumerate(yn_dicts):
        if isinstance(item, tuple) and len(item) >= 2:
            path = item[0]
            dict_data = item[1]
            
            # Create a summary of the dictionary
            summary = str(dict_data)
            if len(summary) > 50:
                summary = summary[:47] + "..."
                
            # Create a choice with the path and summary
            choice_text = f"{path}: {summary}"
            choices.append({'name': choice_text, 'value': i})
    
    try:
        # Let user select a dictionary
        question = {
            'type': 'list',
            'name': 'selected_dict',
            'message': 'Select a dictionary:',
            'choices': choices
        }
        
        answer = prompt([question], style=custom_style)
        
        check_interrupted()  # Check if Ctrl+C was pressed
        
        if not answer or 'selected_dict' not in answer:
            print("No selection made. Exiting.")
            sys.exit(0)
        
        selected_index = answer['selected_dict']
        return yn_dicts[selected_index]
        
    except Exception as e:
        if interrupted:  # Check if the exception was due to interruption
            sys.exit(0)
        raise e


