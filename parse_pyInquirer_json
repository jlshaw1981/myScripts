def extract_ip_addresses(data: Any, ip_info: List[Dict] = None) -> List[Dict]:
    """
    Recursively extract all IP addresses from the dictionary.
    
    Args:
        data: The dictionary to extract IPs from
        ip_info: List to store found IP addresses and hostnames
        
    Returns:
        List of dictionaries with 'hostname' and 'ip_address' keys
    """
    check_interrupted()  # Check if Ctrl+C was pressed
    
    if ip_info is None:
        ip_info = []
    
    # If data is a dictionary
    if isinstance(data, dict):
        # Check if this dictionary contains both hostname and ip_address
        if "Hostname" in data and "ip_address" in data:
            ip_info.append({
                "hostname": data["Hostname"],
                "ip_address": data["ip_address"],
            })
        
        # Check all values in this dictionary
        for value in data.values():
            if isinstance(value, (dict, list)):
                extract_ip_addresses(value, ip_info)
    
    # If data is a list
    elif isinstance(data, list):
        # Check each item in the list
        for item in data:
            if isinstance(item, (dict, list)):
                extract_ip_addresses(item, ip_info)
    
    return ip_info


def ssh_connect(host: str, username: str, password: str = None, key_path: str = None, port: int = 22) -> paramiko.SSHClient:
    """
    Connect to a remote host via SSH.
    
    Args:
        host: Remote host IP address or hostname
        username: SSH username
        password: SSH password (optional)
        key_path: Path to private key file (optional)
        port: SSH port (default: 22)
        
    Returns:
        SSHClient object if connection successful, None otherwise
    """
    check_interrupted()  # Check if Ctrl+C was pressed
    
    client = paramiko.SSHClient()
    client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    
    try:
        if key_path:
            key = paramiko.RSAKey.from_private_key_file(key_path)
            client.connect(hostname=host, port=port, username=username, pkey=key, timeout=10)
        else:
            client.connect(hostname=host, port=port, username=username, password=password, timeout=10)
        
        print(f"Successfully connected to {host}")
        return client
    except Exception as e:
        if interrupted:  # Check if the exception was due to interruption
            return None
        print(f"SSH connection failed to {host}: {e}")
        return None


def execute_ssh_command(client: paramiko.SSHClient, command: str) -> Tuple[str, str, int]:
    """
    Execute a command on a remote host via SSH.
    
    Args:
        client: SSHClient object
        command: Command to execute
        
    Returns:
        Tuple containing (stdout, stderr, return_code)
    """
    check_interrupted()  # Check if Ctrl+C was pressed
    
    try:
        # Execute the command
        stdin, stdout, stderr = client.exec_command(command, timeout=30)
        
        # Get the return code
        return_code = stdout.channel.recv_exit_status()
        
        check_interrupted()  # Check if Ctrl+C was pressed
        
        # Get output
        stdout_str = stdout.read().decode('utf-8')
        stderr_str = stderr.read().decode('utf-8')
        
        return stdout_str, stderr_str, return_code
    except Exception as e:
        if interrupted:  # Check if the exception was due to interruption
            return "", "Operation cancelled by user", -1
        return "", str(e), -1


def execute_audit_worker(host_info: Dict, ssh_username: str, ssh_password: str = None, key_path: str = None,
                         result_queue: queue.Queue = None) -> Dict:
    """
    Worker function to execute audit on a single host.
    
    Args:
        host_info: Dictionary with host information
        ssh_username: SSH username
        ssh_password: SSH password (optional)
        key_path: Path to private key file (optional)
        result_queue: Queue to put results in (optional)
        
    Returns:
        Dictionary with audit results
    """
    global interrupted
    
    ip = host_info["ip_address"]
    hostname = host_info["hostname"]
    
    host_results = {
        "hostname": hostname,
        "ip_address": ip,
        "commands": []
    }
    
    if interrupted:  # Check if Ctrl+C was pressed before starting work
        host_results["error"] = "Operation cancelled by user"
        if result_queue is not None:
            result_queue.put(host_results)
        return host_results
    
    print(f"\n{'=' * 60}")
    print(f"Executing Audit on {hostname} ({ip}):")
    print(f"{'=' * 60}")
    
    # Connect to SSH
    ssh_client = ssh_connect(ip, ssh_username, ssh_password, key_path)
    
    if ssh_client:
        # List of audit commands to run
        audit_commands = [
            "hostname",
            "ping -c 4 1.1.1.1",
            "ifconfig || ip a",
            "route -n || ip route",
            "cat /etc/os-release",
            "uname -a",
            "uptime"
        ]
        
        # Execute each audit command
        print(f"\nExecuting audit commands on {hostname}...")
        for cmd in audit_commands:
            if interrupted:  # Check if Ctrl+C was pressed before executing command
                host_results["error"] = "Operation cancelled by user"
                break
                
            print(f"\n--- {hostname}: Command: {cmd} ---")
            stdout, stderr, return_code = execute_ssh_command(ssh_client, cmd)
            
            command_result = {
                "command": cmd,
                "return_code": return_code,
                "stdout": stdout,
                "stderr": stderr
            }
            
            host_results["commands"].append(command_result)
            
            if return_code == 0:
                print(f"{hostname}: {cmd} executed successfully")
            else:
                print(f"{hostname}: {cmd} failed with error code {return_code}")
        
        # Close SSH connection
        ssh_client.close()
        print(f"\nSSH connection to {hostname} closed")
        print(f"{'=' * 60}")
    else:
        print(f"Audit failed: Could not establish SSH connection to {hostname} ({ip})")
        host_results["error"] = "SSH connection failed"
    
    # Put results in queue if provided
    if result_queue is not None and not interrupted:
        result_queue.put(host_results)
    
    return host_results


def run_multithreaded_audit(selected_hosts: List[Dict], max_workers: int = 10) -> List[Dict]:
    """
    Run audit commands on multiple hosts using threads.
    
    Args:
        selected_hosts: List of dictionaries with host information
        max_workers: Maximum number of worker threads
        
    Returns:
        List of dictionaries with audit results
    """
    global interrupted
    audit_results = []
    result_queue = queue.Queue()
    
    check_interrupted()  # Check if Ctrl+C was pressed
    
    try:
        # Get common SSH credentials
        print("\nEnter common SSH credentials for all hosts:")
        
        username_question = {
            'type': 'input',
            'name': 'ssh_username',
            'message': 'Enter SSH username:'
        }
        username_answer = prompt([username_question], style=custom_style)
        
        check_interrupted()  # Check if Ctrl+C was pressed
        
        if not username_answer or 'ssh_username' not in username_answer:
            print("No username provided. Exiting.")
            return []
        
        ssh_username = username_answer['ssh_username']
        
        # Ask for authentication method
        auth_question = {
            'type': 'list',
            'name': 'auth_method',
            'message': 'Select authentication method:',
            'choices': ['Password', 'Private Key']
        }
        auth_answer = prompt([auth_question], style=custom_style)
        
        check_interrupted()  # Check if Ctrl+C was pressed
        
        if not auth_answer or 'auth_method' not in auth_answer:
            print("No authentication method selected. Exiting.")
            return []
        
        ssh_password = None
        key_path = None
        
        if auth_answer['auth_method'] == "Password":
            password_question = {
                'type': 'password',
                'name': 'ssh_password',
                'message': 'Enter SSH password:'
            }
            password_answer = prompt([password_question], style=custom_style)
            
            if password_answer and 'ssh_password' in password_answer:
                ssh_password = password_answer['ssh_password']
        else:  # Private Key
            key_question = {
                'type': 'input',
                'name': 'key_path',
                'message': 'Enter path to private key file:'
            }
            key_answer = prompt([key_question], style=custom_style)
            
            if key_answer and 'key_path' in key_answer:
                key_path = key_answer['key_path']
        
        check_interrupted()  # Check if Ctrl+C was pressed
        
        # Ask for maximum concurrent connections
        actual_max_workers = min(max_workers, len(selected_hosts))
        worker_choices = [{'name': str(n), 'value': n} for n in range(1, actual_max_workers + 1)]
        
        workers_question = {
            'type': 'list',
            'name': 'num_workers',
            'message': 'Select maximum concurrent connections:',
            'choices': worker_choices
        }
        workers_answer = prompt([workers_question], style=custom_style)
        
        check_interrupted()  # Check if Ctrl+C was pressed
        
        if not workers_answer or 'num_workers' not in workers_answer:
            print("No worker count selected. Using default of 1.")
            num_workers = 1
        else:
            num_workers = workers_answer['num_workers']
        
        print(f"\nUsing {num_workers} concurrent connections")
        
        # Create a thread pool
        with ThreadPoolExecutor(max_workers=num_workers) as executor:
            # Submit tasks
            futures = []
            for host in selected_hosts:
                if interrupted:  # Check if Ctrl+C was pressed before submitting tasks
                    break
                    
                future = executor.submit(
                    execute_audit_worker,
                    host_info=host,
                    ssh_username=ssh_username,
                    ssh_password=ssh_password,
                    key_path=key_path,
                    result_queue=result_queue
                )
                futures.append(future)
            
            # Track progress
            completed = 0
            total = len(futures)
            
            while completed < total and not interrupted:
                completed = sum(1 for f in futures if f.done())
                print(f"\rProgress: {completed}/{total} hosts completed", end="")
                time.sleep(0.5)
            
            if interrupted:
                print("\nAudit interrupted by user. Waiting for running tasks to complete...")
                # We don't need to cancel tasks here, as the workers check for interruption
            else:
                print("\nAll hosts completed!")
        
        # Get results from queue
        while not result_queue.empty():
            audit_results.append(result_queue.get())
        
    except Exception as e:
        if interrupted:  # Check if the exception was due to interruption
            print("\nOperation cancelled by user during credential input.")
        else:
            print(f"Error during multithreaded audit: {e}")
    
    return audit_results


def run_network_commands(ip_info: List[Dict]) -> List[Dict]:
    """
    Run network commands on each IP address.
    
    Args:
        ip_info: List of dictionaries with 'hostname' and 'ip_address' keys
        
    Returns:
        List of dictionaries with audit results
    """
    check_interrupted()  # Check if Ctrl+C was pressed
    
    if not ip_info:
        print("No IP addresses found in the selected dictionary.")
        return []
    
    # Display found hosts and IPs
    print("\nFound the following hosts and IP addresses:")
    print("-" * 60)
    print(f"{'Hostname':<30} {'IP Address':<15}")
    print("-" * 60)
    for item in ip_info:
        print(f"{item['hostname']:<30} {item['ip_address']:<15}")
    print("-" * 60)
    
    try:
        # Let user select which IPs to run commands on
        choices = [{'name': f"{item['hostname']} ({item['ip_address']})", 'value': item} for item in ip_info]
        
        hosts_question = {
            'type': 'checkbox',
            'name': 'selected_hosts',
            'message': 'Select hosts to audit:',
            'choices': choices
        }
        hosts_answer = prompt([hosts_question], style=custom_style)
        
        check_interrupted()  # Check if Ctrl+C was pressed
        
        if not hosts_answer or 'selected_hosts' not in hosts_answer or not hosts_answer['selected_hosts']:
            print("No hosts selected. Skipping audit.")
            return []
        
        selected_hosts = hosts_answer['selected_hosts']
        
        check_interrupted()  # Check if Ctrl+C was pressed
        
        # Ask if user wants to use multithreading
        threading_question = {
            'type': 'confirm',
            'name': 'use_threading',
            'message': 'Do you want to run audit commands in parallel on all hosts?',
            'default': True
        }
        threading_answer = prompt([threading_question], style=custom_style)
        
        check_interrupted()  # Check if Ctrl+C was pressed
        
        use_threading = threading_answer.get('use_threading', True)
        
        if use_threading:
            # Run commands in parallel
            audit_results = run_multithreaded_audit(selected_hosts)
        else:
            # Run commands sequentially
            audit_results = []
            for host in selected_hosts:
                if interrupted:  # Check if Ctrl+C was pressed before processing next host
                    break
                
                # Get SSH credentials for each host
                print(f"\nEnter SSH credentials for {host['hostname']} ({host['ip_address']}):")
                
                username_question = {
                    'type': 'input',
                    'name': 'ssh_username',
                    'message': f'Enter SSH username for {host["hostname"]}:'
                }
                username_answer = prompt([username_question], style=custom_style)
                
                check_interrupted()  # Check if Ctrl+C was pressed
                
                if not username_answer or 'ssh_username' not in username_answer:
                    print(f"No username provided for {host['hostname']}. Skipping.")
                    continue
                
                ssh_username = username_answer['ssh_username']
                
                # Ask for authentication method
                auth_question = {
                    'type': 'list',
                    'name': 'auth_method',
                    'message': f'Select authentication method for {host["hostname"]}:',
                    'choices': ['Password', 'Private Key']
                }
                auth_answer = prompt([auth_question], style=custom_style)
                
                check_interrupted()  # Check if Ctrl+C was pressed
                
                if not auth_answer or 'auth_method' not in auth_answer:
                    print(f"No authentication method selected for {host['hostname']}. Skipping.")
                    continue
                
                ssh_password = None
                key_path = None
                
                if auth_answer['auth_method'] == "Password":
                    password_question = {
                        'type': 'password',
                        'name': 'ssh_password',
                        'message': f'Enter SSH password for {host["hostname"]}:'
                    }
                    password_answer = prompt([password_question], style=custom_style)
                    
                    if password_answer and 'ssh_password' in password_answer:
                        ssh_password = password_answer['ssh_password']
                else:  # Private Key
                    key_question = {
                        'type': 'input',
                        'name': 'key_path',
                        'message': 'Enter path to private key file:'
                    }
                    key_answer = prompt([key_question], style=custom_style)
                    
                    if key_answer and 'key_path' in key_answer:
                        key_path = key_answer['key_path']
                
                check_interrupted()  # Check if Ctrl+C was pressed
                
                # Execute audit
                host_result = execute_audit_worker(
                    host_info=host,
                    ssh_username=ssh_username,
                    ssh_password=ssh_password,
                    key_path=key_path
                )
                
                audit_results.append(host_result)
        
        return audit_results
    
    except Exception as e:
        if interrupted:  # Check if the exception was due to interruption
            print("\nOperation cancelled by user during host selection.")
            return []
        else:
            print(f"Error during network commands: {e}")
            return []


def save_audit_results(audit_results: List[Dict]) -> None:
    """
    Save audit results to a file.
    
    Args:
        audit_results: List of dictionaries with audit results
    """
    check_interrupted()  # Check if Ctrl+C was pressed
    
    if not audit_results:
        print("No audit results to save.")
        return
    
    try:
        # Ask if user wants to save the audit results
        save_question = {
            'type': 'confirm',
            'name': 'save_to_file',
            'message': 'Do you want to save the audit results to a file?'
        }
        save_answer = prompt([save_question], style=custom_style)
        
        check_interrupted()  # Check if Ctrl+C was pressed
        
        if not save_answer.get('save_to_file', False):
            return
        
        # Ask for output directory
        dir_question = {
            'type': 'input',
            'name': 'output_dir',
            'message': 'Enter output directory (leave empty for current directory):',
            'default': ''
        }
        dir_answer = prompt([dir_question], style=custom_style)
        
        check_interrupted()  # Check if Ctrl+C was pressed
        
        output_dir = dir_answer.get('output_dir', '')
        
        if output_dir and not os.path.exists(output_dir):
            try:
                os.makedirs(output_dir)
                print(f"Created directory: {output_dir}")
            except Exception as e:
                print(f"Error creating directory: {e}")
                output_dir = ""
        
        # Save results for each host
        for host_result in audit_results:
            if interrupted:  # Check if Ctrl+C was pressed before saving next file
                break
                
            hostname = host_result["hostname"]
            ip = host_result["ip_address"]
            
            # Create filename
            filename = f"audit_{hostname}_{ip.replace('.', '_')}.txt"
            if output_dir:
                filepath = os.path.join(output_dir, filename)
            else:
                filepath = filename
            
            try:
                with open(filepath, 'w') as file:
                    file.write(f"Audit Results for {hostname} ({ip})\n")
                    file.write("=" * 60 + "\n\n")
                    
                    if "error" in host_result:
                        file.write(f"ERROR: {host_result['error']}\n\n")
                    
                    for cmd_result in host_result.get("commands", []):
                        command = cmd_result.get("command", "Unknown command")
                        return_code = cmd_result.get("return_code", -1)
                        stdout = cmd_result.get("stdout", "")
                        stderr = cmd_result.get("stderr", "")
                        
                        file.write(f"Command: {command}\n")
                        file.write("-" * 40 + "\n")
                        
                        if return_code == 0:
                            file.write(f"Output:\n{stdout}\n")
                        else:
                            file.write(f"Command failed with error code {return_code}:\n")
                            if stderr:
                                file.write(f"{stderr}\n")
                        
                        file.write("\n" + "-" * 40 + "\n\n")
                
                print(f"Successfully saved audit results to filename {filepath}")
            except Exception as e:
                print(f"Error saving audit results: {e}")
    
    except Exception as e:
        if interrupted:  # Check if the exception was due to interruption
            print("\nOperation cancelled by user during file saving.")
        else:
            print(f"Error saving audit results: {e}")

