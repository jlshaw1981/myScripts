def scp_path_info(remote_host: str, username: str, password: str = None, 
                  key_path: str = None, port: int = 22, remote_path: str = None, 
                  local_path: str = '.') -> bool:
    """
    Standard SCP function to pull path_info.json from remote host to local.
    
    Args:
        remote_host: Remote host IP address or hostname
        username: Username for remote host
        password: Password for remote host (optional)
        key_path: Path to private key file (optional)
        port: SSH port (default: 22)
        remote_path: Path to path_info.json on remote host (optional, will search if not provided)
        local_path: Local destination directory (default: current directory)
        
    Returns:
        bool: True if successful, False otherwise
    """
    try:
        check_interrupted()  # Check if Ctrl+C was pressed
        
        print(f"Connecting to {remote_host}...")
        ssh_client = ssh_connect(remote_host, username, password, key_path, port)
        
        if not ssh_client:
            print(f"Failed: Could not establish SSH connection to {remote_host}")
            return False
        
        # If remote_path not specified, search for path_info.json
        if not remote_path:
            common_paths = [
                './path_info.json',
                '~/path_info.json', 
                '/tmp/path_info.json',
                '/opt/path_info.json',
                '/home/cisco/Desktop/pathInfo/path_info.json',
                f'/home/{username}/path_info.json'
            ]
            
            print("Searching for path_info.json on remote host...")
            stdin, stdout, stderr = ssh_client.exec_command('find / -name "path_info.json" -type f 2>/dev/null | head -5')
            found_files = stdout.read().decode().strip().split('\n')
            
            # Try found files first, then common paths
            search_paths = [f for f in found_files if f] + common_paths
            
            remote_path = None
            for path in search_paths:
                try:
                    stdin, stdout, stderr = ssh_client.exec_command(f'test -f "{path}" && echo "exists"')
                    if stdout.read().decode().strip() == "exists":
                        remote_path = path
                        print(f"Found path_info.json at: {remote_path}")
                        break
                except:
                    continue
            
            if not remote_path:
                print("Could not find path_info.json on remote host")
                return False
        
        # Use SCP to transfer the file
        try:
            import scp
            
            scp_client = scp.SCPClient(ssh_client.get_transport())
            local_file_path = os.path.join(local_path, 'path_info.json')
            
            print(f"Transferring {remote_path} to {local_file_path}...")
            scp_client.get(remote_path, local_file_path)
            scp_client.close()
            
            # Verify the transfer
            if os.path.exists(local_file_path):
                file_size = os.path.getsize(local_file_path)
                print(f"Transfer successful: path_info.json ({file_size} bytes) transferred to {local_file_path}")
                return True
            else:
                print("Transfer failed: File not found locally after transfer")
                return False
                
        except ImportError:
            # If scp library not available, use command line scp
            import subprocess
            
            local_file_path = os.path.join(local_path, 'path_info.json')
            
            if key_path:
                cmd = ['scp', '-P', str(port), '-i', key_path, '-o', 'StrictHostKeyChecking=no',
                       f'{username}@{remote_host}:{remote_path}', local_file_path]
            else:
                cmd = ['scp', '-P', str(port), '-o', 'StrictHostKeyChecking=no',
                       f'{username}@{remote_host}:{remote_path}', local_file_path]
            
            print(f"Executing: scp {username}@{remote_host}:{remote_path} {local_file_path}")
            result = subprocess.run(cmd, capture_output=True, text=True)
            
            if result.returncode == 0:
                if os.path.exists(local_file_path):
                    file_size = os.path.getsize(local_file_path)
                    print(f"Transfer successful: path_info.json ({file_size} bytes) transferred to {local_file_path}")
                    return True
            else:
                print(f"SCP command failed: {result.stderr}")
                return False
    
    except KeyboardInterrupt:
        print("\nTransfer interrupted by user")
        return False
    except Exception as e:
        if 'interrupted' in globals() and interrupted:
            return False
        print(f"SCP transfer failed: {e}")
        return False
    finally:
        if 'ssh_client' in locals() and ssh_client:
            ssh_client.close()
    
    return False


def scp_path_info_reverse(host2: str, host1: str, host1_username: str, host1_password: str = None,
                         host1_key_path: str = None, remote_path: str = None, local_path: str = '.', 
                         username: str = None, password: str = None, key_path: str = None, 
                         port: int = 22, host1_port: int = 22) -> bool:
    """
    Connect to Host #2, then use SCP from Host #2 to push path_info.json to Host #1.
    
    Args:
        host2: Remote host #2 IP address or hostname (intermediate host)
        host1: Host #1 IP address or hostname (final destination)
        host1_username: Username for Host #1
        host1_password: Password for Host #1 (optional)
        host1_key_path: Path to private key file for Host #1 on Host #2 (optional)
        remote_path: Path to path_info.json on Host #2 (optional, will search if not provided)
        local_path: Destination path on Host #1 (default: current directory)
        username: Username for Host #2
        password: Password for Host #2 (optional)
        key_path: Path to private key file for Host #2 (optional)
        port: SSH port for Host #2 (default: 22)
        host1_port: SSH port for Host #1 (default: 22)
        
    Returns:
        bool: True if successful, False otherwise
    """
    try:
        check_interrupted()  # Check if Ctrl+C was pressed
        
        # Connect to Host #2
        print(f"Connecting to Host #2: {host2}...")
        ssh_client = ssh_connect(host2, username, password, key_path, port)
        
        if not ssh_client:
            print(f"Failed: Could not establish SSH connection to Host #2 ({host2})")
            return False
        
        # If remote_path not specified, search for path_info.json on Host #2
        if not remote_path:
            common_paths = [
                './path_info.json',
                '~/path_info.json', 
                '/tmp/path_info.json',
                '/opt/path_info.json',
                '/home/cisco/Desktop/pathInfo/path_info.json',
                '/home/{}/path_info.json'.format(username or 'user')
            ]
            
            print("Searching for path_info.json on Host #2...")
            stdin, stdout, stderr = ssh_client.exec_command('find / -name "path_info.json" -type f 2>/dev/null | head -5')
            found_files = stdout.read().decode().strip().split('\n')
            
            # Try found files first, then common paths
            search_paths = [f for f in found_files if f] + common_paths
            
            remote_path = None
            for path in search_paths:
                try:
                    # Check if file exists
                    stdin, stdout, stderr = ssh_client.exec_command(f'test -f "{path}" && echo "exists"')
                    if stdout.read().decode().strip() == "exists":
                        remote_path = path
                        print(f"Found path_info.json at: {remote_path}")
                        break
                except:
                    continue
            
            if not remote_path:
                print("Could not find path_info.json on Host #2")
                return False
        
        # Verify the source file exists and is readable
        print(f"Verifying source file on Host #2: {remote_path}")
        stdin, stdout, stderr = ssh_client.exec_command(f'test -r "{remote_path}" && echo "readable"')
        if stdout.read().decode().strip() != "readable":
            print(f"Source file is not readable: {remote_path}")
            return False
        
        # Build the SCP command to push from Host #2 to Host #1
        host1_destination = f"{host1_username}@{host1}:{local_path}/path_info.json"
        
        # Build SCP command with appropriate authentication
        if host1_key_path:
            # Use SSH key authentication
            scp_command = f'scp -P {host1_port} -i "{host1_key_path}" -o StrictHostKeyChecking=no "{remote_path}" "{host1_destination}"'
        elif host1_password:
            # Use sshpass for password authentication
            scp_command = f'sshpass -p "{host1_password}" scp -P {host1_port} -o StrictHostKeyChecking=no "{remote_path}" "{host1_destination}"'
        else:
            # Try without explicit authentication (may use SSH agent or existing keys)
            scp_command = f'scp -P {host1_port} -o StrictHostKeyChecking=no "{remote_path}" "{host1_destination}"'
        
        print(f"Executing SCP from Host #2 to Host #1...")
        print(f"Command: scp {remote_path} -> {host1_username}@{host1}:{local_path}/")
        
        # Execute the SCP command on Host #2
        stdin, stdout, stderr = ssh_client.exec_command(scp_command)
        
        # Wait for command completion and get results
        exit_status = stdout.channel.recv_exit_status()
        stdout_data = stdout.read().decode()
        stderr_data = stderr.read().decode()
        
        check_interrupted()  # Check if Ctrl+C was pressed
        
        if exit_status == 0:
            print("SCP transfer completed successfully!")
            
            # Verify the transfer by checking if file exists on Host #1
            verify_command = f'ssh -p {host1_port} -o StrictHostKeyChecking=no '
            if host1_key_path:
                verify_command += f'-i "{host1_key_path}" '
            elif host1_password:
                verify_command = f'sshpass -p "{host1_password}" ' + verify_command
            
            verify_command += f'{host1_username}@{host1} "test -f {local_path}/path_info.json && stat -c%s {local_path}/path_info.json"'
            
            print("Verifying transfer on Host #1...")
            stdin, stdout, stderr = ssh_client.exec_command(verify_command)
            verify_exit = stdout.channel.recv_exit_status()
            
            if verify_exit == 0:
                file_size = stdout.read().decode().strip()
                print(f"Transfer verified: path_info.json ({file_size} bytes) successfully transferred to Host #1")
                return True
            else:
                print("Warning: Could not verify file transfer on Host #1")
                return True  # Still return True as SCP reported success
        else:
            print(f"SCP transfer failed with exit status: {exit_status}")
            if stderr_data:
                print(f"Error details: {stderr_data}")
            return False
    
    except KeyboardInterrupt:
        print("\nTransfer interrupted by user")
        return False
    except Exception as e:
        if 'interrupted' in globals() and interrupted:
            return False
        print(f"Reverse SCP transfer failed: {e}")
        return False
    finally:
        # Close SSH connection if it exists
        if 'ssh_client' in locals() and ssh_client:
            ssh_client.close()


