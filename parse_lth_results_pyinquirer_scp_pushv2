def load_json_file(file_path: str) -> Dict:
    """
    Load and parse the JSON file.
    
    Args:
        file_path: Path to the JSON file
        
    Returns:
        Parsed JSON data as a dictionary
    """
    try:
        check_interrupted()  # Check if Ctrl+C was pressed
        
        with open(file_path, 'r') as file:
            data = json.load(file)
        print(f"Successfully loaded data from {file_path}")
        return data
    except FileNotFoundError:
        print(f"Error: File {file_path} not found.")
        sys.exit(1)
    except json.JSONDecodeError:
        print(f"Error: {file_path} is not a valid JSON file.")
        sys.exit(1)
    except Exception as e:
        if interrupted:  # Check if the exception was due to interruption
            sys.exit(0)
        print(f"Error loading JSON file: {e}")
        sys.exit(1)


def find_yn_dictionaries(data: Any, path: str = "", results: List[Tuple[str, Dict]] = None) -> List[Tuple[str, Dict]]:
    """
    Recursively find all dictionaries with keys starting with "YN-".
    
    Args:
        data: The JSON data to search through
        path: Current path in the JSON structure (for tracking location)
        results: List to store found dictionaries
        
    Returns:
        List of tuples containing (path, dictionary)
    """
    check_interrupted()  # Check if Ctrl+C was pressed
    
    if results is None:
        results = []
    
    # If data is a dictionary
    if isinstance(data, dict):
        # Check all keys in this dictionary
        for key, value in data.items():
            current_path = f"{path}.{key}" if path else key
            
            # Check if this key starts with "YN-"
            if key.startswith("YN-"):
                results.append((current_path, data[key]))
            
            # Recursively check nested dictionaries
            if isinstance(value, (dict, list)):
                find_yn_dictionaries(value, current_path, results)
                
    # If data is a list
    elif isinstance(data, list):
        # Check each item in the list
        for i, item in enumerate(data):
            current_path = f"{path}[{i}]"
            if isinstance(item, (dict, list)):
                find_yn_dictionaries(item, current_path, results)
    
    return results


def display_yn_dictionaries(yn_dicts: List[Tuple[str, Dict]]) -> Tuple[str, Dict]:
    """
    Display the found dictionaries and let user choose one using PyInquirer.
    
    Args:
        yn_dicts: List of tuples containing (path, dictionary)
        
    Returns:
        Tuple containing (path, selected dictionary)
    """
    check_interrupted()  # Check if Ctrl+C was pressed
    
    if not yn_dicts:
        print("No dictionaries with keys starting with 'YN-' found in the JSON file.")
        sys.exit(0)
    
    print(f"Found {len(yn_dicts)} dictionaries with keys starting with 'YN-':")
    
    # Create choices for PyInquirer
    choices = []
    # Fix the unpacking issue by safely accessing tuple elements
    for i, item in enumerate(yn_dicts):
        if isinstance(item, tuple) and len(item) >= 2:
            path = item[0]
            dict_data = item[1]
            
            # Create a summary of the dictionary
            summary = str(dict_data)
            if len(summary) > 50:
                summary = summary[:47] + "..."
                
            # Create a choice with the path and summary
            choice_text = f"{path}: {summary}"
            choices.append({'name': choice_text, 'value': i})
    
    try:
        # Let user select a dictionary
        question = {
            'type': 'list',
            'name': 'selected_dict',
            'message': 'Select a dictionary:',
            'choices': choices
        }
        
        answer = prompt([question], style=custom_style)
        
        check_interrupted()  # Check if Ctrl+C was pressed
        
        if not answer or 'selected_dict' not in answer:
            print("No selection made. Exiting.")
            sys.exit(0)
        
        selected_index = answer['selected_dict']
        return yn_dicts[selected_index]
        
    except Exception as e:
        if interrupted:  # Check if the exception was due to interruption
            sys.exit(0)
        raise e


